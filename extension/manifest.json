{
  "manifest_version": 3,
  "name": "Thinking of You",
  "version": "0.2",
  "description": "Adds products you view or cart on shopping sites to your Thinking of You list.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*", "https://*.onrender.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Thinking of You" },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*", "https://*.etsy.com/*", "https://*.target.com/*",
        "https://*.walmart.com/*", "https://*.shein.com/*", "https://*.ebay.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}